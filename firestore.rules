rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default deny all undefined paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidProduct(data) {
      return data.id is string && data.id.size() <= 100 &&
             data.name is string && data.name.size() <= 200 &&
             data.price is number && data.price >= 0 &&
             data.stock is number && data.stock >= 0;
    }

    function isValidOrder(data) {
      return data.id is string && data.id.size() <= 100 &&
             data.customerName is string && data.customerName.size() <= 200 &&
             data.customerPhone is string && data.customerPhone.size() <= 50 &&
             data.customerAddress is string && data.customerAddress.size() <= 1000 &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             data.items is list && data.items.size() > 0 && data.items.size() <= 50 &&
             data.status is string && data.status.size() <= 50;
    }

    // Products catalog: Public read for storefront display; writes allowed for valid product schema
    match /products/{productId} {
      allow read: if true;
      allow create, update: if isValidProduct(request.resource.data);
      allow delete: if isAdmin() || !isSignedIn();
    }

    // Orders: Anyone can create an order; reading, status update and deletion for management
    match /orders/{orderId} {
      allow read: if true;
      allow create: if isValidOrder(request.resource.data);
      allow update: if request.resource.data.status is string &&
                      request.resource.data.status.size() <= 50 &&
                      request.resource.data.status in ['pending_payment', 'paid_verified', 'preparing', 'shipped', 'cancelled'];
      allow delete: if true;
    }

    // Visitor statistics counter (starts at 200)
    match /stats/{statId} {
      allow read: if true;
      allow create, update: if request.resource.data.count is number && request.resource.data.count >= 200;
    }

    // Admin whitelist collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
